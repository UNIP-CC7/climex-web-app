# Copie para .env (cp .env.example .env) e reinicie o npm run dev depois de mudar algo.

# true usa os serviços simulados (padrão, não precisa da API).
# false liga o painel à climex-api: login por telefone e senha e dados reais.
VITE_USE_MOCKS=true

# Só vale com VITE_USE_MOCKS=false e só no npm run dev. Endereço da climex-api, sem barra no final.
# O painel chama /v1 no próprio endereço e o Vite repassa para cá (proxy), então o navegador não barra o PATCH por CORS.
# Local, com a API rodando por docker compose: http://localhost:3000 (é o padrão se a linha abaixo ficar comentada).
# VITE_API_URL=http://localhost:3000

# Painel publicado (build de produção): origem pública da climex-api, só a origem (sem caminho, sem /v1).
# Fica dentro do arquivo JavaScript público e recebe os tokens da sessão: aponte só para a API de verdade.
# Sem esta variável o painel chama o próprio endereço, o que funciona no npm run dev (proxy do Vite) ou quando o servidor encaminha /v1 para a API.
# Exige VITE_USE_MOCKS=false. A API precisa liberar a origem do painel em CORS_ALLOWED_ORIGINS, os métodos GET, POST e PATCH
# e os cabeçalhos Authorization, Content-Type e X-Request-Id no preflight (OPTIONS).
# VITE_API_BASE_URL=https://api.exemplo.com.br
