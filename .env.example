# Copie para .env (cp .env.example .env) e reinicie o npm run dev depois de mudar algo.

# true usa os serviços simulados (padrão enquanto a API não está publicada).
# false ainda não é suportado: o painel não carrega. Veja docs/contrato-api.md.
VITE_USE_MOCKS=true

# Reservada. Endereço da climex-api, sem barra no final (ainda não usada pelo painel).
# Local, com a API rodando por docker compose: http://localhost:3000
# VITE_API_URL=http://localhost:3000
